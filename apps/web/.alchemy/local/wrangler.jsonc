{
  "name": "budget-web-root",
  "main": "worker.js",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": [],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": false,
  },
  "vars": {
    "VITE_CONVEX_URL": "https://precise-wren-298.convex.cloud",
    "VITE_CONVEX_SITE_URL": "https://precise-wren-298.convex.site",
  },
}
