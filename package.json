{
  "name": "budget",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @budget/backend dev",
    "dev:setup": "turbo -F @budget/backend dev:setup",
    "deploy:backend": "turbo -F @budget/backend deploy",
    "check": "oxlint && oxfmt --write",
    "lint:check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@budget/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@budget/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20251213.0",
    "lefthook": "^2.0.13",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.0"
}
