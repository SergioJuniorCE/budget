{
  "name": "budget",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "deploy:backend": "turbo -F @budget/backend deploy",
    "check": "oxlint && oxfmt --write",
    "lint:check": "oxlint && oxfmt --check",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "backend:deploy": "pnpm --filter @budget/backend run deploy",
    "web:build": "pnpm --filter web build"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@budget/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20251213.0",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "lefthook": "^2.0.13",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.0"
}
